<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark framework theme: no AppCompat dependency required.
         statusBarColor / navigationBarColor are ignored on Android 15+ (edge
         to edge is enforced) and only affect Android 8 to 14. -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@color/window_bg</item>
        <item name="android:navigationBarColor">@color/window_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
